meta {
  name: Signup
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/signup
  body: json
  auth: none
}

body:json {
  {
    "email": "you@test.com",
    "password": "password123"
  }
}

script:post-response {
  if (res.body && res.body.dev_verify_url) {
    bru.setEnvVar("verifyUrl", res.body.dev_verify_url);
  }
}

docs {
  Creates an UNVERIFIED account. In dev mode the response includes
  `dev_verify_url`, captured here into `verifyUrl` for the Verify request.
}
