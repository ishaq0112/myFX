# Copy this file to ".env" and fill in your Neon connection string.
# Get it from the Neon dashboard: Project -> Connection Details -> "Connection string".
# The ".env" file is gitignored so your credentials stay out of version control.
#
# Without DATABASE_URL the API still runs, but rates are kept in memory only
# (lost on restart). Set it to persist the daily snapshot to Neon.

DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/DBNAME?sslmode=require

# --- Public base URL (used to build email-verification links) ---
APP_URL=http://localhost:3000

# --- Google sign-in (OAuth) ---
# Create these in Google Cloud Console -> APIs & Services -> Credentials ->
# "OAuth client ID" (type: Web application). Add this exact redirect URI:
#   http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Any long random string. Signs the Google OAuth state, and encrypts two-factor
# secrets at rest. Required for two-factor auth (2FA is unavailable without it).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Don't change it once users have 2FA on: their authenticator codes would stop
# working (they'd need a recovery code to sign in and set 2FA up again).
APP_SECRET=change-me-to-a-long-random-string

# --- Email delivery (optional) ---
# Without RESEND_API_KEY, verification links are printed to the server console
# (dev mode). To send real emails, get a key at https://resend.com and set:
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=MyFX <you@your-verified-domain.com>